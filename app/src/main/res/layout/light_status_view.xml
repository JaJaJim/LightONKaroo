<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/light_status_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. Glow Layer (Background - drawn BEHIND logo, icons and text) -->
    <ImageView
        android:id="@+id/light_glow_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0.7"
        android:visibility="gone"
        android:contentDescription="" />

    <!-- 2. Background Logo (Janus Sun SVG) -->
    <ImageView
        android:id="@+id/light_icon"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/ic_light"
        android:scaleType="fitCenter"
        android:alpha="1.0"
        android:contentDescription="@string/light_status" />

    <!-- 3. Tiny Top-Left Lamp Icon -->
    <ImageView
        android:id="@+id/light_indicator_tiny"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="4dp"
        android:layout_marginTop="6dp"
        android:src="@drawable/ic_lamp_tiny"
        android:contentDescription="@string/light_status" />

    <!-- 4. Center Text Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/light_mode_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="2"
            android:text="--" />

        <TextView
            android:id="@+id/light_device_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <TextView
            android:id="@+id/light_device_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#DDDDDD"
            android:shadowColor="#000000"
            android:shadowDx="1"
            android:shadowDy="1"
            android:shadowRadius="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />

        <!-- Battery, Radar & Temperature Status Row -->
        <LinearLayout
            android:id="@+id/light_battery_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/light_radar_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_radar"
                android:visibility="gone"
                android:contentDescription="" />

            <ImageView
                android:id="@+id/light_battery_icon"
                android:layout_width="16dp"
                android:layout_height="12dp"
                android:layout_marginEnd="4dp"
                android:src="@drawable/ic_battery_status" />

            <TextView
                android:id="@+id/light_battery_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#AAAAAA"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:text="" />

            <ImageView
                android:id="@+id/light_temp_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="2dp"
                android:src="@drawable/ic_thermometer"
                android:visibility="gone"
                android:contentDescription="" />

            <TextView
                android:id="@+id/light_temp_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#32E09A"
                android:shadowColor="#000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="1"
                android:visibility="gone"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- 5. Click Zones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">
        <FrameLayout
            android:id="@+id/light_status_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
        <FrameLayout
            android:id="@+id/light_status_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

</RelativeLayout>
